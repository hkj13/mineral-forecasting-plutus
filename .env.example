# Mineral Forecasting Platform - Environment Variables
# Copy this file to .env and fill in your values

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0

# Database (optional - for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/mineral_db

# Authentication
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Demo Credentials (change in production)
DEMO_USER_EMAIL=judge@plutus.iitism.ac.in
DEMO_USER_PASSWORD=Plutus2025!

# External APIs (optional)
# DGCIS_API_KEY=your-dgcis-api-key
# TRADESTAT_API_KEY=your-tradestat-api-key

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Vercel Deployment
# VERCEL_URL will be automatically set by Vercel
